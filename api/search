vement","tags":[],"type":"text","url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Data-Movement#operation-flags","content":"GRF\\[rs]"},"1933":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Data-Movement-21","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Data-Movement","tags":[],"type":"text","url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Data-Movement#operation-flags","content":"GRF\\[rd] + imm"},"1934":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Data-Movement-22","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Data-Movement","tags":[],"type":"text","url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Data-Movement#operation-flags","content":"`SRC_O`"},"1935":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Data-Movement-23","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Data-Movement","tags":[],"type":"text","url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Data-Movement#operation-flags","content":"110010"},"1936":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Data-Movement-24","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Data-Movement","tags":[],"type":"text","url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Data-Movement#operation-flags","content":"GRF\\[rs] + imm"},"1937":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Data-Movement-25","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Data-Movement","tags":[],"type":"text","url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Data-Movement#operation-flags","content":"GRF\\[rd]"},"1938":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Data-Movement-26","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Data-Movement","tags":[],"type":"text","url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Data-Movement#operation-flags","content":"`SRC_O, DST_O`"},"1939":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Data-Movement-27","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Data-Movement","tags":[],"type":"text","url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Data-Movement#operation-flags","content":"110011"},"1940":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Data-Movement-28","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Data-Movement","tags":[],"type":"text","url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Data-Movement#operation-flags","content":"GRF\\[rs] + imm"},"1941":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Data-Movement-29","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Data-Movement","tags":[],"type":"text","url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Data-Movement#operation-flags","content":"GRF\\[rd] + imm"},"1942":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Data-Movement-30","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Data-Movement","tags":[],"type":"text","url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Data-Movement#operation-flags","content":"The transfer size is specified in bytes via `GRF[rt]`. When both flags are set, the same immediate offset value is used for both source and destination addresses."},"1943":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Communication","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Communication","type":"page","content":"Inter-Core Communication","breadcrumbs":["Documentation","Abstraction","ISA","Instruction Design","Instruction Set"],"tags":[],"url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Communication"},"1944":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Communication-0","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Communication","tags":[],"type":"text","url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Communication","content":"Cross-core data transmission and synchronization instructions"},"1945":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Communication-1","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Communication","type":"heading","tags":[],"url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Communication#send","content":"SEND"},"1946":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Communication-2","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Communication","type":"heading","tags":[],"url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Communication#recv","content":"RECV"},"1947":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Communication-3","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Communication","type":"heading","tags":[],"url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Communication#examples","content":"Examples"},"1948":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Communication-4","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Communication","tags":[],"type":"text","url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Communication","content":"Inter-core communication instructions enable data exchange and synchronization between processing cores in a multi-core architecture. These instructions use communication IDs to ensure reliable, ordered message passing."},"1949":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Communication-5","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Communication","tags":[],"type":"text","url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Communication#send","content":"Initiates a data transmission from the current core to a remote receiver core. The instruction specifies sender/receiver IDs, destination address, transfer size, and a communication ID for acknowledgment tracking."},"1950":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Communication-6","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Communication","tags":[],"type":"text","url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Communication#recv","content":"Receives data from a remote sender core. The instruction specifies sender ID, source/destination addresses, transfer size, and a communication ID that must match the corresponding SEND operation."},"1951":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Communication-7","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Communication","tags":[],"type":"text","url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Communication#recv","content":"Communication IDs must match between SEND and RECV operations. Mismatched IDs may cause deadlock or data corruption."},"1952":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Synchronization","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Synchronization","type":"page","content":"Inter-Core Synchronization","breadcrumbs":["Documentation","Abstraction","ISA","Instruction Design","Instruction Set"],"tags":[],"url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Synchronization"},"1953":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Synchronization-0","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Synchronization","tags":[],"type":"text","url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Synchronization","content":"Multi-core synchronization and barrier instructions"},"1954":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Synchronization-1","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Synchronization","type":"heading","tags":[],"url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Synchronization#wait","content":"WAIT"},"1955":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Synchronization-2","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Synchronization","type":"heading","tags":[],"url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Synchronization#barrier","content":"BARRIER"},"1956":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Synchronization-3","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Synchronization","type":"heading","tags":[],"url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Synchronization#tag","content":"TAG"},"1957":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Synchronization-4","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Synchronization","type":"heading","tags":[],"url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Synchronization#examples","content":"Examples"},"1958":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Synchronization-5","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Synchronization","tags":[],"type":"text","url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Synchronization","content":"Inter-core synchronization instructions provide fine-grained coordination primitives for multi-core systems, enabling both pairwise synchronization and collective barrier operations across multiple cores."},"1959":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Synchronization-6","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Synchronization","tags":[],"type":"text","url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Synchronization#wait","content":"Performs pairwise synchronization between cores. The current core blocks until a specified synchronization point is reached, with flexible control over which core(s) to wait for and expected write count."},"1960":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Synchronization-7","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Synchronization","tags":[],"type":"text","url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Synchronization#wait","content":"WAIT works in conjunction with TAG for producer-consumer synchronization. When GRF\\[rs] is 0, WAIT blocks until global synchronization; when set to a specific core ID, it waits for that core's TAG."},"1961":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Synchronization-8","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Synchronization","tags":[],"type":"text","url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Synchronization#barrier","content":"Performs a collective synchronization across multiple cores using a barrier protocol. All participating cores must reach the barrier before any can proceed, ensuring global consistency in multi-core computations."},"1962":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Synchronization-9","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Synchronization","tags":[],"type":"text","url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Synchronization#barrier","content":"All cores must execute BARRIER with identical `num_cores` and `barrier_id` values. Mismatched parameters will cause deadlock."},"1963":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Synchronization-10","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Synchronization","tags":[],"type":"text","url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Synchronization#tag","content":"Marks a synchronization point on the current core, signaling completion of work to other cores waiting via WAIT instruction."},"1964":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Synchronization-11","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Synchronization","tags":[],"type":"text","url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Inter-Core-Synchronization#tag","content":"TAG is used in conjunction with WAIT to implement producer-consumer synchronization patterns. A core signals completion of a phase by executing TAG, and other cores unblock by using WAIT with the same sync ID."},"1965":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Intra-Core-Control","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Intra-Core-Control","type":"page","content":"Intra-Core Control","breadcrumbs":["Documentation","Abstraction","ISA","Instruction Design","Instruction Set"],"tags":[],"url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Intra-Core-Control"},"1966":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Intra-Core-Control-0","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Intra-Core-Control","tags":[],"type":"text","url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Intra-Core-Control","content":"Control flow instructions for branching and jumping"},"1967":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Intra-Core-Control-1","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Intra-Core-Control","type":"heading","tags":[],"url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Intra-Core-Control#branch","content":"BRANCH"},"1968":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Intra-Core-Control-2","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Intra-Core-Control","type":"heading","tags":[],"url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Intra-Core-Control#branch-variants","content":"Branch Variants"},"1969":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Intra-Core-Control-3","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Intra-Core-Control","type":"heading","tags":[],"url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Intra-Core-Control#jmp","content":"JMP"},"1970":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Intra-Core-Control-4","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Intra-Core-Control","type":"heading","tags":[],"url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Intra-Core-Control#examples","content":"Examples"},"1971":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Intra-Core-Control-5","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Intra-Core-Control","tags":[],"type":"text","url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Intra-Core-Control","content":"Intra-core control instructions manage program execution flow within a single core, providing both conditional branching based on register comparisons and unconditional jumps using PC-relative addressing."},"1972":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Intra-Core-Control-6","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Intra-Core-Control","tags":[],"type":"text","url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Intra-Core-Control#branch","content":"Performs a conditional jump based on comparison of two register values. The instruction supports four comparison types encoded in the opcode, enabling efficient decision-making for loops, conditionals, and control flow."},"1973":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Intra-Core-Control-7","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Intra-Core-Control","tags":[],"type":"text","url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Intra-Core-Control#branch-variants","content":"The opcode bits `XX` specify the comparison operation:"},"1974":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Intra-Core-Control-8","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Intra-Core-Control","tags":[],"type":"text","url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Intra-Core-Control#branch-variants","content":"Branch offset is PC-relative: `target = PC + imm`. The offset is measured in instruction units from the next instruction."},"1975":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Intra-Core-Control-9","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Intra-Core-Control","tags":[],"type":"text","url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Intra-Core-Control#jmp","content":"Performs an unconditional jump to a target address specified by a PC-relative offset. Unlike BRANCH, JMP always transfers control regardless of any condition."},"1976":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Intra-Core-Control-10","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Intra-Core-Control","tags":[],"type":"text","url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Intra-Core-Control#jmp","content":"JMP provides a larger offset range (26 bits) compared to BRANCH (16 bits), enabling jumps across larger code sections."},"1977":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Matrix-Vector-Operation","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Matrix-Vector-Operation","type":"page","content":"Matrix–Vector Operation","breadcrumbs":["Documentation","Abstraction","ISA","Instruction Design","Instruction Set"],"tags":[],"url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Matrix-Vector-Operation"},"1978":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Matrix-Vector-Operation-0","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Matrix-Vector-Operation","tags":[],"type":"text","url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Matrix-Vector-Operation","content":"Computing-in-memory matrix-vector multiplication instructions"},"1979":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Matrix-Vector-Operation-1","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Matrix-Vector-Operation","type":"heading","tags":[],"url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Matrix-Vector-Operation#cim_mvm","content":"CIM_MVM"},"1980":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Matrix-Vector-Operation-2","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Matrix-Vector-Operation","type":"heading","tags":[],"url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Matrix-Vector-Operation#operation-flags","content":"Operation Flags"},"1981":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Matrix-Vector-Operation-3","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Matrix-Vector-Operation","type":"heading","tags":[],"url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Matrix-Vector-Operation#examples","content":"Examples"},"1982":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Matrix-Vector-Operation-4","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Matrix-Vector-Operation","tags":[],"type":"text","url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Matrix-Vector-Operation","content":"Matrix–vector operations leverage the CIM array for efficient parallel multiplication between weight matrices and input vectors, enabling high-performance deep learning inference."},"1983":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Matrix-Vector-Operation-5","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Matrix-Vector-Operation","tags":[],"type":"text","url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Matrix-Vector-Operation#cim_mvm","content":"Performs matrix-vector multiplication (MVM) using the CIM array, computing the product of a weight matrix stored in CIM and an input feature vector from local memory. Supports batch operations via configurable flag bits."},"1984":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Matrix-Vector-Operation-6","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Matrix-Vector-Operation","tags":[],"type":"text","url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Matrix-Vector-Operation#operation-flags","content":"The `flags` field controls execution modes for CIM matrix-vector multiplication. Multiple flags can be combined to optimize computation."},"1985":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Matrix-Vector-Operation-7","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Matrix-Vector-Operation","tags":[],"type":"text","url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Matrix-Vector-Operation#operation-flags","content":"**Accumulation (ACC)** is always enabled by default - results are accumulated to the output buffer. This flag is implicit and not exposed in assembly syntax."},"1986":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation","type":"page","content":"Scalar Operation","breadcrumbs":["Documentation","Abstraction","ISA","Instruction Design","Instruction Set"],"tags":[],"url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation"},"1987":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation-0","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation","tags":[],"type":"text","url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation","content":"Scalar arithmetic, load/store, and register move instructions"},"1988":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation-1","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation","type":"heading","tags":[],"url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation#arithmetic","content":"Arithmetic"},"1989":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation-2","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation","type":"heading","tags":[],"url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation#sc_rr","content":"SC_RR"},"1990":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation-3","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation","type":"heading","tags":[],"url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation#sc_ri","content":"SC_RI"},"1991":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation-4","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation","type":"heading","tags":[],"url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation#memory","content":"Memory"},"1992":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation-5","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation","type":"heading","tags":[],"url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation#sc_ld","content":"SC_LD"},"1993":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation-6","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation","type":"heading","tags":[],"url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation#sc_st","content":"SC_ST"},"1994":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation-7","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation","type":"heading","tags":[],"url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation#immediate-load","content":"Immediate Load"},"1995":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation-8","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation","type":"heading","tags":[],"url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation#g_li","content":"G_LI"},"1996":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation-9","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation","type":"heading","tags":[],"url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation#s_li","content":"S_LI"},"1997":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation-10","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation","type":"heading","tags":[],"url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation#register-move","content":"Register Move"},"1998":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation-11","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation","type":"heading","tags":[],"url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation#gs_mov","content":"GS_MOV"},"1999":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation-12","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation","type":"heading","tags":[],"url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation#sg_mov","content":"SG_MOV"},"2000":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation-13","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation","type":"heading","tags":[],"url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation#examples","content":"Examples"},"2001":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation-14","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation","tags":[],"type":"text","url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation","content":"Scalar operations handle single-value computations: address calculations, loop counters, control flow, and configuration of the CIM and Vector units. They operate on two register files:"},"2002":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation-15","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation","tags":[],"type":"text","url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation","content":"**GRF** (General Register File): 32 general-purpose registers (`$0`-`$31`) for arithmetic, addresses, and temporary values"},"2003":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation-16","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation","tags":[],"type":"text","url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation","content":"**SRF** (Special Register File): Configuration registers that control CIM array dimensions, vector lengths, and compute modes"},"2004":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation-17","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation","tags":[],"type":"text","url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation#sc_rr","content":"Performs an arithmetic or logical operation on two source registers and writes the result to a destination register."},"2005":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation-18","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation","tags":[],"type":"text","url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation#sc_ri","content":"Performs an operation using a register and an 11-bit signed immediate value (−1024 to 1023)."},"2006":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation-19","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation","tags":[],"type":"text","url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation#sc_ri","content":"Append **I** for immediate variants (e.g., `ADD` → `ADDI`)"},"2007":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation-20","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation","tags":[],"type":"text","url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation#sc_ld","content":"Loads a value from local memory into a general register using base+offset addressing."},"2008":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation-21","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation","tags":[],"type":"text","url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation#sc_st","content":"Stores a register value to local memory using base+offset addressing."},"2009":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation-22","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation","tags":[],"type":"text","url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation#g_li","content":"Loads a 21-bit unsigned immediate (0 to 2,097,151) directly into a general register."},"2010":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation-23","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation","tags":[],"type":"text","url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation#s_li","content":"Loads a 21-bit immediate into a special register. Used to configure CIM array and Vector unit parameters before compute operations."},"2011":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation-24","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation","tags":[],"type":"text","url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation#s_li","content":"See Register Files for the SRF register map."},"2012":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation-25","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation","tags":[],"type":"text","url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation#gs_mov","content":"Copies a value from a general register to a special register. Use when the configuration value is computed at runtime."},"2013":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation-26","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation","tags":[],"type":"text","url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Scalar-Operation#sg_mov","content":"Copies a value from a special register to a general register. Use to read configuration state or status values."},"2014":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Vector-Operation","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Vector-Operation","type":"page","content":"Vector Operation","breadcrumbs":["Documentation","Abstraction","ISA","Instruction Design","Instruction Set"],"tags":[],"url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Vector-Operation"},"2015":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Vector-Operation-0","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Vector-Operation","tags":[],"type":"text","url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Vector-Operation","content":"SIMD vector operations and reduction instructions"},"2016":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Vector-Operation-1","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Vector-Operation","type":"heading","tags":[],"url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Vector-Operation#vec_op","content":"VEC_OP"},"2017":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Vector-Operation-2","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Vector-Operation","type":"heading","tags":[],"url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Vector-Operation#input-vector-modes","content":"Input Vector Modes"},"2018":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Vector-Operation-3","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Vector-Operation","type":"heading","tags":[],"url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Vector-Operation#function-codes","content":"Function Codes"},"2019":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Vector-Operation-4","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Vector-Operation","type":"heading","tags":[],"url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Vector-Operation#reduce","content":"REDUCE"},"2020":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Vector-Operation-5","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Vector-Operation","type":"heading","tags":[],"url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Vector-Operation#reduction-functions","content":"Reduction Functions"},"2021":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Vector-Operation-6","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Vector-Operation","type":"heading","tags":[],"url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Vector-Operation#examples","content":"Examples"},"2022":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Vector-Operation-7","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Vector-Operation","tags":[],"type":"text","url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Vector-Operation","content":"Vector operations enable Single Instruction, Multiple Data (SIMD) processing for efficient parallel computation on arrays. These instructions support element-wise operations, activation functions, quantization, and aggregation across vector elements."},"2023":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Vector-Operation-8","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Vector-Operation","tags":[],"type":"text","url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Vector-Operation#vec_op","content":"Performs SIMD operations on 1-4 input vectors, applying the same operation to corresponding elements in parallel. Supports various functions including activation functions (ReLU), quantization, and arithmetic operations."},"2024":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Vector-Operation-9","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Vector-Operation","tags":[],"type":"text","url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Vector-Operation#input-vector-modes","content":"In the instruction syntax, `Z` determines the number of input vectors.\n`Z` corresponds to the opcode bits `XY`:"},"2025":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Vector-Operation-10","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Vector-Operation","tags":[],"type":"text","url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Vector-Operation#input-vector-modes","content":"For operations with >2 input vectors, addresses for vectors 3 and 4 are sourced from dedicated vector registers configured separately."},"2026":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Vector-Operation-11","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Vector-Operation","tags":[],"type":"text","url":"/docs/Abstraction/Instruction-Design/Instruction-Set/Vector-Operation#function-codes","content":"Complete list of SIMD vector operation function codes (funct field) as defined in the implementation:"},"2027":{"id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Vector-Operation-12","page_id":"/docs/Abstraction/Instruction-Design/Instruction-Set/Vector-Operation","tags":[],"type":"